 },
 "references": [],
 "shared": {
  "BRAND": {
   "source": "NONE",
   "values": {
    "mtype": "BRAND"
   },
   "why": "Base is brand-free: it says nothing of how a brand's marks are used, and holds no colour, because an app's colours are its own theme's, set in its src/spn.surface.json."
  },
  "DRAWING": {
   "source": "OWN",
   "values": {
    "mtype": "DRAWING",
    "drawingStyle": {
     "lineWeights": {
      "detail": 0.75,
      "line": 1,
      "focus": 1.25
     },
     "lineStyles": {
      "SOLID": "edges and wires",
      "DASHED": "a reply, an inactive unit, a slot you fill",
      "DOTTED": "a guide or a boundary"
     },
     "grid": 4,
     "lineOpacity": false,
     "textLevels": [
      "LABEL",
      "NAME",
      "DETAIL"
     ]
    },
    "colourAndStrength": {
     "dashedLine": {
      "color": "MUTED_TEXT"
     },
     "dottedGuide": {
      "color": "ACCENT",
      "strengthPercent": 24
     },
     "dottedBoundary": {
      "color": "ACCENT",
      "strengthPercentLight": 45,
      "strengthPercentDark": 55
     },
     "illustrationLine": {
      "color": "INK",
      "strength": "FULL"
     }
    },
    "characters": {
     "inTheDesignSystem": "NONE",
     "drawnBy": "A_LANGUAGE_THAT_WANTS_THEM"
    },
    "howTheBlocksMeet": {
     "wireEnds": "MIDDLE_OF_FACING_EDGE",
     "wireLabel": "CLEAR_OF_WIRE",
     "plateName": "INSIDE_PLATE",
     "wordsInset": "KEPT_NO_EDGE_CROSSES",
     "glyphAndWords": "ONE_MIDDLE",
     "wordsUnderAName": "ONE_SHORT_LINE",
     "codeInDrawing": "REAL",
     "noWireCrossesAWire": true
    },
    "drawingScale": {
     "steps": {
      "S": "IN_A_CARD",
      "M": "BESIDE_OR_UNDER_WORDS",
      "L": "IN_A_HERO"
     },
     "text": {
      "LABEL": {
       "S": 9,
       "M": 9.5,
       "L": 10.5
      },
      "NAME": {
       "S": 11,
       "M": 12,
       "L": 14
      },
      "DETAIL": {
       "S": 9.5,
       "M": 10,
       "L": 11.5
      }
     },
     "smallestWord": 9,
     "lineWeights": {
      "detail": 0.75,
      "line": 1,
      "focus": 1.25
     },
     "grid": 4,
     "textShrinksToFit": false,
     "madeAt": "1:1"
    }
   },
   "why": "Every drawing is made on one scale, with three weights, three styles and no faded line, so that two drawings read as one hand's; the sizes and percentages are SaaS Plane's defaults, which a language that draws may change."
  },
  "MOTION": {
   "source": "INHERITED",
   "values": {
    "mtype": "MOTION"
   },
   "why": "Speed and easing are the design system's own, and no language sets its own timing yet; reduced motion holds everything still (RULE.SUPPORT.SURFACE.201)."
  },
  "VOICE": {
   "source": "NONE",
   "values": {
    "mtype": "VOICE",
    "howItSpeaks": null
   },
   "why": "Surface's voice is not written yet, so no part of this language holds one."
  }
