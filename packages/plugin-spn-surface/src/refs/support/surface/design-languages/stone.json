    "highlight": "stage",
    "lit": true
  },
  "interactionStyle": {
    "door": "a lit edge under the pointer",
    "reveal": { "text": "FADE", "media": "FADE", "items": "NONE" },
    "moving": "none"
  },
  "mediaStyle": {
    "screen": "framed, raised",
    "diagram": "flat, thin line, one accent",
