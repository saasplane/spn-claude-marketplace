    "order": ["Hero", "Statement", "Show it", "Points", "Real sample", "Numbers", "Questions", "Closing call", "Footer"]
  },
  "sectionStyle": {
    "ground": "dark",
    "sectionSize": "MD",
    "parting": "HAIRLINE",
    "pattern": "NONE",
