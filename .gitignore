.DS_Store
__pycache__/

# ── registry credentials: an .npmrc carries an auth token, and distribution here is
#    identity-gated end to end — one `git add -A` would put it in history forever ──
.npmrc
.claude/settings.local.json
.claude/saasplane/spn-symbols.json

# ── what a run proved, not what a person wrote: each plugin's tests/run.mjs under packages/plugin-*/
#    writes its artifact here, rewritten with a fresh timestamp on every run ──
**/tests/.output/

# ── the root build's dev dependencies (esbuild): installed by `pnpm install`, never shipped —
#    a plugin's src/ imports only Node built-ins, and its dist/ bundles are committed ──
node_modules/
