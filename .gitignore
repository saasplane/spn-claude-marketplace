.DS_Store
__pycache__/

# ── registry credentials: an .npmrc carries an auth token, and distribution here is
#    identity-gated end to end — one `git add -A` would put it in history forever ──
.npmrc
.claude/settings.local.json
.claude/saasplane/spn-symbols.json

# ── what a run proved, not what a person wrote: the suites in plugins/spn-devex/hooks/tests/
#    write their artifact here, rewritten with a fresh timestamp on every run ──
**/tests/.output/
